{
  "name": "foxtracker",
  "version-string": "1.0.0",
  "description": "FOXTracker - Face tracking application for flight simulators",
  "homepage": "https://github.com/jyf/FOXTracker",
  "dependencies": [
    {
      "name": "qtbase",
      "features": ["network", "widgets"]
    },
    "qtdeclarative",
    "qtcharts",
    {
      "name": "opencv4",
      "features": ["calib3d", "contrib", "dnn", "eigen", "highgui"]
    },
    "eigen3",
    "ceres",
    "glog",
    "yaml-cpp",
    "dlib",
    "onnxruntime",
    "libusb",
    "sdl2"
  ]
}
